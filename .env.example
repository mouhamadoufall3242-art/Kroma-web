# =============================================================================
# KROMA — chiavi necessarie al funzionamento reale
# -----------------------------------------------------------------------------
# Questo file è solo un MODELLO: contiene i nomi, mai i valori.
# Va versionato. Il file con i valori veri, NO.
#
# USO IN LOCALE
#   cp .env.example .dev.vars      poi riempi i valori
#   npm run dev
#   (.dev.vars è già in .gitignore — wrangler legge da lì durante `wrangler dev`)
#
# USO IN PRODUZIONE
#   I segreti NON si mettono in nessun file. Si caricano cifrati su Cloudflare:
#     npx wrangler secret put ANTHROPIC_API_KEY
#     npx wrangler secret put RESEND_API_KEY
#     npx wrangler secret put STRIPE_SECRET_KEY
#     npx wrangler secret put STRIPE_WEBHOOK_SECRET
#   In alternativa dal pannello: Workers & Pages → kroma → Settings →
#   Variables and Secrets → Add → tipo "Secret".
#
# SE UNA CHIAVE MANCA, il codice non si rompe: entra in modalità simulata
# (anteprima segnaposto, email nei log, URL di pagamento finta). Comodo per
# provare, inutile per incassare.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ANTHROPIC — genera l'HTML delle anteprime
# -----------------------------------------------------------------------------
# Da console.anthropic.com → API Keys.
# Senza: callAnthropicAPI restituisce una pagina segnaposto.
ANTHROPIC_API_KEY="sk-ant-..."


# -----------------------------------------------------------------------------
# 2. RESEND — manda al cliente il link della sua anteprima
# -----------------------------------------------------------------------------
# Da resend.com → API Keys.
# Prima serve un dominio verificato (voci DNS), altrimenti le email partono
# ma finiscono nello spam.
# Senza: sendEmailToClient scrive nel log invece di spedire.
RESEND_API_KEY="re_..."


# -----------------------------------------------------------------------------
# 3. STRIPE — incassa
# -----------------------------------------------------------------------------
# Da dashboard.stripe.com → Sviluppatori → Chiavi API.
# In prova usa sk_test_…; sk_live_… muove denaro vero sul tuo conto.
# Senza: /api/checkout restituisce una URL di pagamento finta.
STRIPE_SECRET_KEY="sk_test_..."

# Da dashboard.stripe.com → Sviluppatori → Webhook → il tuo endpoint →
# "Firma segreta". In locale lo stampa:
#   stripe listen --forward-to localhost:8787/api/webhooks/stripe
#
# NON è opzionale: senza, /api/webhooks/stripe rifiuta OGNI chiamata con 503.
# È voluto. Un webhook di pagamento che accetta richieste non firmate è una
# porta aperta: chiunque può mandare un POST con scritto "pagato" e attivare
# un pacchetto senza pagarlo.
STRIPE_WEBHOOK_SECRET="whsec_..."


# =============================================================================
# NON SONO SEGRETI — stanno in [vars] dentro wrangler.toml
# -----------------------------------------------------------------------------
# Elencati qui solo perché servono anche loro perché tutto funzioni.
# Gli id prezzo identificano un listino, non autorizzano nessuna operazione:
# possono stare tranquillamente nel repository.
#
#   SITE_URL                   dominio pubblico del sito
#   EMAIL_FROM                 mittente delle email ai clienti
#   EMAIL_REPLY_TO             indirizzo a cui rispondono i clienti
#   ANTHROPIC_MODEL            modello usato per generare
#   PREVIEW_TTL_DAYS           giorni di conservazione delle anteprime
#   RATE_LIMIT_PER_HOUR        tetto di generazioni per IP
#   STRIPE_PRICE_CODICE        price_… del pacchetto da 290 € una tantum
#   STRIPE_PRICE_ABBONAMENTO   price_… dei 29 €/mese
#   STRIPE_PRICE_ATTIVAZIONE   price_… dei 90 € di attivazione
# =============================================================================
